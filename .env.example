# Database: PostgreSQL (Neon, Supabase or any Postgres 14+). Use the pooled or direct URL from your
# provider. sslmode=require is needed for Neon and Supabase.
# Local example: create a database, then set DATABASE_URL to postgresql://USER:PASSWORD@localhost:5432/smartbite
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/smartbite?sslmode=require"

# AI Multimodal Vision & Grocery Planner API Keys
# The app works out-of-the-box with free keyless fallback & local heuristics.
# For high-speed dedicated limits, supply one or more of the following:

# 1. Google Gemini (Recommended for Bangladesh regional meal understanding & grocery intelligence)
# Get a free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# 2. Groq Vision (Llama-4 Scout & Llama 3)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=""

# 3. OpenRouter (Multi-model router)
# Get a free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# Optional Model Overrides
GEMINI_MODEL="gemini-flash-lite-latest"
GROQ_VISION_MODEL="meta-llama/llama-4-scout-17b-16e-instruct"

# Session signing secret (required in production, at least 32 characters).
# Generate one with: openssl rand -base64 32
AUTH_SECRET=""

# Nutrition data sources (optional). USDA_API_KEY defaults to DEMO_KEY, which is rate-limited.
# Get a free key at https://api.data.gov/signup/
USDA_API_KEY=""
# Edamam Nutrition Analysis (optional; needs an app id and key from developer.edamam.com)
EDAMAM_APP_ID=""
EDAMAM_APP_KEY=""
# Set to "false" to turn off live nutrition lookups.
NUTRITION_LOOKUP_ENABLED=""
DEMO_ACCOUNT_ENABLED="true"   # set to false to hide the one-click demo (recommended for public launch)

# Historical retail prices (optional). A CSV export of the Kaggle "Global Food Prices" dataset.
# Commodity names are matched with src/lib/data/commodity-map.json.
# PRICE_HISTORY_CSV=/absolute/path/to/global_food_prices.csv
# PRICE_HISTORY_COUNTRY=Bangladesh
# USD_TO_BDT=120

# Nutritics (optional). The URL template comes from the account's Nutritics documentation.
# Placeholders: {query} and {key}.
# NUTRITICS_SEARCH_URL=https://<your-nutritics-endpoint>/search?q={query}&key={key}
# NUTRITICS_API_KEY=
